clear all
clc
close all
%%
%%
global bpGlobal
bpGratingFCGlobal;

%%% data path and session list
%%%%%%%%%%%%%%%%%%%%%%%%%% specify session list %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%% session list of rolo
session_list_ro = bpGlobal.rolo.session_list.switching;

%%%% session list of gremlin
session_list_gr = bpGlobal.gremlin.session_list.interleaved_real;

session_list_all    = [session_list_ro; session_list_gr];
nSession            = numel(session_list_all);
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%% specify data path %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
taskDataPath_Ro         = '/Users/liushizhao/projectData_local/probinf_data/extractedData/Ro/bpGratingFC';


taskDataPath_Gr         = '/Users/liushizhao/projectData_local/probinf_data/extractedData/Gr/bpGratingFC';

%% 1. filter trials based on eye position distance from the mean distance
doThis = 1;
if doThis
    percent_keep         = 75;
    part_option          = 'surround'; % center or surround 
    assert(ismember(part_option,{'center';'surround'}),'Invalid option string for which part to keep');
    criterion_message    = sprintf(['Compute Euclidean distance of eye position from the average position. \n',...
                                    'Keep the trials within the %s %d percentile',part_option, percent_keep]);

    filter_name          = sprintf('distanceEyePosition_%s_prctile%d',  part_option, percent_keep);
    savePath             = fullfile('../../results/filter_trial',filter_name);
    txtName              = fullfile(savePath,sprintf('criterion_%s.txt',filter_name));
    saveName             = fullfile(savePath,sprintf('filtered_trials_%s',filter_name));


    %%%%%%%%%%%%%%%% save criterion message in a .txt file   %%%%%%%%%%%%
    mkdir(savePath);
    fid = fopen(txtName,'wt');
    fprintf(fid, criterion_message);
    fclose(fid);

    %%%%%%%%%%%%%%%%%%%%%%%%% also keep some crierion in a struct  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    keep_options                = struct();
    keep_options.trialOptions   = filter_name;


    %%%%%%%%%%%%%%%%%%%%%%%%%% make the real struct for filtered neurons and trials %%%%%%%%%%%%%%%%%%%%%%
    filtered_trials = struct();


     for i = 1:nSession
        sessionStr  = session_list_all{i};
        subjectCode = sessionStr(1:2);
        dateStr     = sessionStr(3:end);
        %%%%% load needed data %%%%%%
        eyePosition_file = sprintf('../../results/eyeMovement/eyeData_avgTrial/%s/%s_eyeData_avgTrial.mat',subjectCode, sessionStr);
        if ~isfile(eyePosition_file)
            error(sprintf('Eye position results of session %s does not exsit', sessionStr));
        end
        load(eyePosition_file);

        %%%% load stimulus data to get task information
        data_folder = sprintf('/Users/liushizhao/projectData_local/probinf_data/extractedData/%s/bpGratingFC', subjectCode);
        dlist = dir(fullfile(data_folder, [sessionStr,'*.mat'] ));
        load(fullfile(data_folder, dlist(1).name),'stimulus');
        
        %trialIdx_zero = find(stimulus.signal == 0);
        signal_level_use    = stimulus.signal(eyeData_avg.trialInd)';
        task_type_use       = stimulus.taskType(eyeData_avg.trialInd);
        
        idx_nonzero         = signal_level_use ~= 0;
        idx_zero_cardinal   = signal_level_use == 0 & strcmp(task_type_use,'C');
        idx_zero_oblique    = signal_level_use == 0 & strcmp(task_type_use,'O');

        eyeCenter_cardinal      = mean(eyeData_avg.eyePosition(idx_zero_cardinal,:),1);
        eyeDistance_cardinal    = sqrt(sum((eyeData_avg.eyePosition - eyeCenter_cardinal) .^ 2 ,2));

        eyeCenter_oblique      = mean(eyeData_avg.eyePosition(idx_zero_oblique,:),1);
        eyeDistance_oblique    = sqrt(sum((eyeData_avg.eyePosition - eyeCenter_oblique) .^ 2 ,2));

        switch part_option
            case 'center'
                dist_thres_cardinal  = prctile(eyeDistance_cardinal(idx_zero_cardinal & ~isnan(eyeDistance_cardinal)), percent_keep);
                 
                dist_thres_oblique  = prctile(eyeDistance_oblique(idx_zero_oblique & ~isnan(eyeDistance_oblique)), percent_keep);

                idx             = idx_nonzero | (idx_zero_cardinal & eyeDistance_cardinal < dist_thres_cardinal) | ...
                                            (idx_zero_oblique & eyeDistance_oblique < dist_thres_oblique);
            case 'surround'
                dist_thres_cardinal  = prctile(eyeDistance_cardinal(idx_zero_cardinal & ~isnan(eyeDistance_cardinal)), 100 - percent_keep);
                 
                dist_thres_oblique  = prctile(eyeDistance_oblique(idx_zero_oblique & ~isnan(eyeDistance_oblique)), 100 - percent_keep);

                idx             = idx_nonzero | (idx_zero_cardinal & eyeDistance_cardinal > dist_thres_cardinal) | ...
                                            (idx_zero_oblique & eyeDistance_oblique > dist_thres_oblique);


        end
        trialInd_kept    = eyeData_avg.trialInd(idx);
        nTrial_total     = numel(eyeData_avg.trialInd);


        %%%%%%%%%%%%%%%%% save all information in a struct %%%%%%%%%%%%%%%%%
        filtered_trials(i).sessionStr           = sessionStr;
        filtered_trials(i).subjectCode          = subjectCode;
        filtered_trials(i).dateStr              = dateStr;
        filtered_trials(i).trialInd_kept        = trialInd_kept; % kept trials
        filtered_trials(i).nTrial_toal          = nTrial_total;


    end
    %%%% save file %%%%
    save(saveName,'filtered_trials','keep_options');

end

%% 2. filter trials based on eye velocity
doThis = 1;
if doThis
    percent_keep         = 75;
    assert(ismember(part_option,{'low';'high'}),'Invalid option string for which part to keep');
    criterion_message    = sprintf(['Keep the trials within the %s %d percentile of average velocity',part_option, percent_keep]);
 
    filter_name          = sprintf('eyeVelocity_%s_prctile%d',  part_option, percent_keep);
    savePath             = fullfile('../../results/filter_trial',filter_name);
    txtName              = fullfile(savePath,sprintf('criterion_%s.txt',filter_name));
    saveName             = fullfile(savePath,sprintf('filtered_trials_%s',filter_name));


    %%%%%%%%%%%%%%%% save criterion message in a .txt file   %%%%%%%%%%%%
    mkdir(savePath);
    fid = fopen(txtName,'wt');
    fprintf(fid, criterion_message);
    fclose(fid);

    %%%%%%%%%%%%%%%%%%%%%%%%% also keep some crierion in a struct  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    keep_options                = struct();
    keep_options.trialOptions   = filter_name;


    %%%%%%%%%%%%%%%%%%%%%%%%%% make the real struct for filtered neurons and trials %%%%%%%%%%%%%%%%%%%%%%
    filtered_trials = struct();


     for i = 1:nSession
        sessionStr  = session_list_all{i};
        subjectCode = sessionStr(1:2);
        dateStr     = sessionStr(3:end);
        %%%%% load needed data %%%%%%
        eyePosition_file = sprintf('../../results/eyeMovement/eyeData_avgTrial/%s/%s_eyeData_avgTrial.mat',subjectCode, sessionStr);
        if ~isfile(eyePosition_file)
            error(sprintf('Eye position results of session %s does not exsit', sessionStr));
        end
        load(eyePosition_file);

        %%%% load stimulus data to get task information
        data_folder = sprintf('/Users/liushizhao/projectData_local/probinf_data/extractedData/%s/bpGratingFC', subjectCode);
        dlist = dir(fullfile(data_folder, [sessionStr,'*.mat'] ));
        load(fullfile(data_folder, dlist(1).name),'stimulus');
        
        %trialIdx_zero = find(stimulus.signal == 0);
        signal_level_use    = stimulus.signal(eyeData_avg.trialInd)';
        task_type_use       = stimulus.taskType(eyeData_avg.trialInd);
        
        idx_nonzero         = signal_level_use ~= 0;
        idx_zero_cardinal   = signal_level_use == 0 & strcmp(task_type_use,'C');
        idx_zero_oblique    = signal_level_use == 0 & strcmp(task_type_use,'O');


        eyeVelocity = sqrt(eyeData_avg.meanEyeVelocity(:,1) .^ 2 + eyeData_avg.meanEyeVelocity(:,2) .^ 2);

 
        switch part_option
            case 'low'
                velo_thres_cardinal   = prctile(eyeVelocity(idx_zero_cardinal & ~isnan(eyeVelocity)), percent_keep);
                velo_thres_oblique    = prctile(eyeVelocity(idx_zero_oblique & ~isnan(eyeVelocity)), percent_keep);                  
                
                idx              = idx_nonzero | (idx_zero_cardinal & eyeVelocity < velo_thres_cardinal) | ...
                                            (idx_zero_oblique & eyeVelocity < velo_thres_oblique);
            case 'high'

                velo_thres_cardinal   = prctile(eyeVelocity(idx_zero_cardinal & ~isnan(eyeVelocity)),100 -  percent_keep);
                velo_thres_oblique    = prctile(eyeVelocity(idx_zero_oblique & ~isnan(eyeVelocity)),100 - percent_keep);                  
                
                idx              = idx_nonzero | (idx_zero_cardinal & eyeVelocity > velo_thres_cardinal) | ...
                                            (idx_zero_oblique & eyeVelocity > velo_thres_oblique);

        end
       
        trialInd_kept    = eyeData_avg.trialInd(idx);
        nTrial_total     = numel(eyeData_avg.trialInd);


        %%%%%%%%%%%%%%%%% save all information in a struct %%%%%%%%%%%%%%%%%
        filtered_trials(i).sessionStr           = sessionStr;
        filtered_trials(i).subjectCode          = subjectCode;
        filtered_trials(i).dateStr              = dateStr;
        filtered_trials(i).trialInd_kept        = trialInd_kept; % kept trials
        filtered_trials(i).nTrial_toal          = nTrial_total;


    end
    %%%% save file %%%%
    save(saveName,'filtered_trials','keep_options');

end

%% 3. filter trials based on pupil size
doThis = 1;
if doThis
    percent_keep         = 75;
    part_option          = 'surround'; % center or surround 
    assert(ismember(part_option,{'center';'surround'}),'Invalid option string for which part to keep');
    criterion_message    = sprintf(['Compute Euclidean distance of eye position from the average position. \n',...
                                    'Keep the trials within the %s %d percentile',part_option, percent_keep]);

    filter_name          = sprintf('distanceEyePosition_%s_prctile%d',  part_option, percent_keep);
    savePath             = fullfile('../../results/filter_trial',filter_name);
    txtName              = fullfile(savePath,sprintf('criterion_%s.txt',filter_name));
    saveName             = fullfile(savePath,sprintf('filtered_trials_%s',filter_name));


    %%%%%%%%%%%%%%%% save criterion message in a .txt file   %%%%%%%%%%%%
    mkdir(savePath);
    fid = fopen(txtName,'wt');
    fprintf(fid, criterion_message);
    fclose(fid);

    %%%%%%%%%%%%%%%%%%%%%%%%% also keep some crierion in a struct  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    keep_options                = struct();
    keep_options.trialOptions   = filter_name;


    %%%%%%%%%%%%%%%%%%%%%%%%%% make the real struct for filtered neurons and trials %%%%%%%%%%%%%%%%%%%%%%
    filtered_trials = struct();


     for i = 1:nSession
        sessionStr  = session_list_all{i};
        subjectCode = sessionStr(1:2);
        dateStr     = sessionStr(3:end);
        %%%%% load needed data %%%%%%
        eyePosition_file = sprintf('../../results/eyeMovement/eyeData_avgTrial/%s/%s_eyeData_avgTrial.mat',subjectCode, sessionStr);
        if ~isfile(eyePosition_file)
            error(sprintf('Eye position results of session %s does not exsit', sessionStr));
        end
        load(eyePosition_file);

        %%%% load stimulus data to get task information
        data_folder = sprintf('/Users/liushizhao/projectData_local/probinf_data/extractedData/%s/bpGratingFC', subjectCode);
        dlist = dir(fullfile(data_folder, [sessionStr,'*.mat'] ));
        load(fullfile(data_folder, dlist(1).name),'stimulus');
        
        %trialIdx_zero = find(stimulus.signal == 0);
        signal_level_use    = stimulus.signal(eyeData_avg.trialInd)';
        task_type_use       = stimulus.taskType(eyeData_avg.trialInd);
        
        idx_nonzero         = signal_level_use ~= 0;
        idx_zero_cardinal   = signal_level_use == 0 & strcmp(task_type_use,'C');
        idx_zero_oblique    = signal_level_use == 0 & strcmp(task_type_use,'O');


        
        pupilSize   = eyeData_avg.meanPupilDiam; 
 
        switch part_option
            case 'low'
                pupil_thres_cardinal   = prctile(pupilSize(idx_zero_cardinal & ~isnan(pupilSize)), percent_keep);
                pupil_thres_oblique    = prctile(pupilSize(idx_zero_oblique & ~isnan(pupilSize)), percent_keep);                  
                
                idx              = idx_nonzero | (idx_zero_cardinal & pupilSize < pupil_thres_cardinal) | ...
                                            (idx_zero_oblique & pupilSize < pupil_thres_oblique);
            case 'high'

                pupil_thres_cardinal   = prctile(pupilSize(idx_zero_cardinal & ~isnan(pupilSize)),100 -  percent_keep);
                pupil_thres_oblique    = prctile(pupilSize(idx_zero_oblique & ~isnan(pupilSize)),100 - percent_keep);                  
                
                idx              = idx_nonzero | (idx_zero_cardinal & pupilSize > pupil_thres_cardinal) | ...
                                            (idx_zero_oblique & pupilSize > pupil_thres_oblique);

        end
       
        trialInd_kept    = eyeData_avg.trialInd(idx);
        nTrial_total     = numel(eyeData_avg.trialInd);


        %%%%%%%%%%%%%%%%% save all information in a struct %%%%%%%%%%%%%%%%%
        filtered_trials(i).sessionStr           = sessionStr;
        filtered_trials(i).subjectCode          = subjectCode;
        filtered_trials(i).dateStr              = dateStr;
        filtered_trials(i).trialInd_kept        = trialInd_kept; % kept trials
        filtered_trials(i).nTrial_toal          = nTrial_total;


    end
    %%%% save file %%%%
    save(saveName,'filtered_trials','keep_options');

end